.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Runtime artifacts: never committed.
.env
data/
keys/

# Credentials. Never committed, and not by exact filename only: any local
# *.token / secret-looking drop should stay out.
htb.txt
*.token
.secrets/
runs/
artifacts/
*.jsonl
!fixtures/**/*.jsonl

# ARTEX checkout used for provisioning is referenced by path, never copied in.
compose/.build/

# Local scratch: vendored reference sources and ad-hoc probe payloads.
# Not shipped, but kept in-tree so nothing lives in /tmp and disappears.
.work/

# Solved-box notes are evidence, not scratch: keep them tracked.
!notes/

# Agent scaffolding (goal ledger, audit transcripts). Not project content.
.pi/
