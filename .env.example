# Copy to .env. Never commit .env.
#
# Postgres password: read by the upstream ARTEX compose file, which requires it.
POSTGRES_PASSWORD=change-me-please
POSTGRES_USER=artex
POSTGRES_DB=artex

# The ARTEX checkout this project builds from. Pinned by commit in
# compose/artex.lock.json; `artexctl up` verifies the checkout matches before
# building (adr/0001-artex-pinning.md).
ARTEX_GYM_ARTEX_SOURCE=/home/pierce/projects/ARTEX

# The model ARTEX drives. Any id the upstream endpoint accepts.
ARTEX_GYM_MODEL=

# Where the collector forwards. Include the /v1 suffix for OpenAI-shaped APIs.
ARTEX_GYM_UPSTREAM_BASE_URL=
# The real provider key. It lives only here and in the collector container;
# ARTEX sees the local token below instead.
ARTEX_GYM_UPSTREAM_API_KEY=

# Local shared secret between ARTEX and the collector. Any value; it is not a
# provider credential and is safe to commit, but keep it out of logs anyway.
ARTEX_GYM_COLLECTOR_TOKEN=artex-gym-local
ARTEX_GYM_COLLECTOR_PORT=4000

# Capture queue bound. Overflow increments collector_dropped_total and never
# blocks the model call.
ARTEX_GYM_QUEUE_MAX=1024
